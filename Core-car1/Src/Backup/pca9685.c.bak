#include "pca9685.h"
#include "i2c.h"
#include "cmsis_os.h" // 必须包含，因为FreeRTOS里用 osDelay

void PCA9685_Write(uint8_t reg, uint8_t data) {
    HAL_I2C_Mem_Write(&hi2c1, 0x80, reg, 1, &data, 1, 100);
}

void PCA9685_Init(void) {
    PCA9685_Write(0x00, 0x10); // 复位
    osDelay(10);               // FreeRTOS里必须用osDelay
    PCA9685_Write(0xFE, 0x79); // 设置50Hz频率
    PCA9685_Write(0x00, 0xA1); // 开启自动递增和振荡器
}

void PCA9685_SetPWM(uint8_t ch, uint16_t off) {
    uint8_t base_reg = 0x06 + 4 * ch;
    uint8_t data[4] = {0, 0, off & 0xFF, off >> 8};
    HAL_I2C_Mem_Write(&hi2c1, 0x80, base_reg, 1, data, 4, 100);
}
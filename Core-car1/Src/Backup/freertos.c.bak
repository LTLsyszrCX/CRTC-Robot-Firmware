osThreadId defaultTaskHandle;
osThreadId ps2Handle;
osThreadId classesHandle;
osThreadId armHandle;
osThreadId debugHandle;

/* Private function prototypes -----------------------------------------------*/
/* USER CODE BEGIN FunctionPrototypes */

